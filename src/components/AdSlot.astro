---
/**
 * Renders an AdSense unit when ADS.enabled, otherwise a subtle labelled
 * placeholder so the layout can be reviewed before the ad account is approved.
 */
import { ADS } from '../config';

interface Props {
  /** Key into ADS.slots */
  slot: keyof typeof ADS.slots | string;
  format?: 'horizontal' | 'rectangle' | 'vertical';
  class?: string;
}

const { slot, format = 'horizontal', class: cls = '' } = Astro.props;
const slotId = ADS.slots[slot];
const live = ADS.enabled && ADS.adsenseClient && slotId;

const minH = { horizontal: 'min-h-[90px]', rectangle: 'min-h-[250px]', vertical: 'min-h-[600px]' }[format];
---

<div class={`my-6 ${cls}`} data-ad-slot={slot}>
  {
    live ? (
      <>
        <ins
          class="adsbygoogle block"
          data-ad-client={ADS.adsenseClient}
          data-ad-slot={slotId}
          data-ad-format={format === 'horizontal' ? 'horizontal' : 'auto'}
          data-full-width-responsive="true"
        />
        <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
      </>
    ) : (
      <div
        class={`surface-2 grid w-full ${minH} place-items-center rounded-xl border border-dashed line text-[11px] font-medium uppercase tracking-widest text-(--color-ink-2)/60`}
      >
        Advertisement
      </div>
    )
  }
</div>
