---
import { SITE } from '../config';
import { CATEGORIES, TOOLS, toolsInCategory } from '../data/tools';
const year = new Date().getFullYear();
---

<footer class="relative mt-20 border-t line surface-2">
  <div class="bg-brand-gradient absolute inset-x-0 top-0 h-px opacity-60"></div>
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-[1.4fr_repeat(3,1fr)]">
    <div>
      <a href="/" class="flex items-center gap-2.5 text-[17px] font-bold tracking-tight">
        <span class="bg-brand-gradient grid h-8 w-8 place-items-center rounded-lg font-mono text-xs font-semibold text-white">{'</>'}</span>
        {SITE.name}
      </a>
      <p class="muted mt-4 max-w-xs text-sm leading-6">
        {TOOLS.length} free developer utilities that run entirely in your browser. Nothing you paste is ever uploaded.
      </p>
    </div>

    {CATEGORIES.slice(0, 3).map((c) => (
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-(--color-ink)">{c.name}</p>
        <ul class="mt-3 space-y-2 text-sm">
          {toolsInCategory(c.name).map((t) => (
            <li><a href={`/tools/${t.slug}/`} class="muted transition hover:text-brand-500">{t.name.replace(/\s*\(.*\)$/, '')}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="border-t line">
    <div class="muted mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-5 text-xs sm:px-6">
      <span>© {year} {SITE.name}. All rights reserved.</span>
      <nav class="flex flex-wrap gap-x-5 gap-y-1">
        <a href="/tools/" class="hover:text-(--color-ink)">All tools</a>
        <a href="/about/" class="hover:text-(--color-ink)">About</a>
        <a href="/contact/" class="hover:text-(--color-ink)">Contact</a>
        <a href="/privacy/" class="hover:text-(--color-ink)">Privacy</a>
        <a href="/terms/" class="hover:text-(--color-ink)">Terms</a>
      </nav>
    </div>
  </div>
</footer>
