---
interface Props {
  name: string;
  class?: string;
}
import { ICON_PATHS } from '../lib/icons';

const { name, class: cls = 'h-5 w-5' } = Astro.props;


const path = ICON_PATHS[name] ?? ICON_PATHS.zap;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={cls}
  aria-hidden="true"
  set:html={path}
/>
