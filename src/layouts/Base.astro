---
import '../styles/global.css';
import { SITE, ADS } from '../config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Path (e.g. "/tools/json-formatter/") — combined with SITE.url for canonical/OG. */
  path: string;
  /** Path to a 1200×630 social image; defaults to the site-wide card. */
  ogImage?: string;
  /** Extra JSON-LD objects to emit. */
  jsonLd?: object[];
  noindex?: boolean;
}

const { title, description, path, ogImage = '/tools/og/site.png', jsonLd = [], noindex = false } = Astro.props;
const canonical = new URL(path, SITE.url).toString();
const ogImageUrl = new URL(ogImage, SITE.url).toString();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/tools/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/tools/sitemap-index.xml" />
    <meta name="theme-color" content="#6366f1" />
    {SITE.googleSiteVerification && <meta name="google-site-verification" content={SITE.googleSiteVerification} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:site" content={SITE.twitter} />

    {jsonLd.map((obj) => <script is:inline type="application/ld+json" set:html={JSON.stringify(obj)} />)}

    {/* Apply the saved/system theme before first paint to avoid a flash. */}
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('theme');
          const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', dark);
        } catch {}
      })();
    </script>

    {
      ADS.adsenseClient && (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADS.adsenseClient}`}
          crossorigin="anonymous"
        />
      )
    }
    {
      ADS.adsenseClient && ADS.autoAds && (
        <script is:inline set:html={`(adsbygoogle=window.adsbygoogle||[]).push({google_ad_client:"${ADS.adsenseClient}",enable_page_level_ads:true});`} />
      )
    }
  </head>
  <body class="flex min-h-screen flex-col font-sans">
    <Header />
    <main class="mx-auto w-full max-w-6xl flex-1 px-4 pb-12 pt-6 sm:px-6">
      <slot />
    </main>
    <Footer />
    {
      SITE.cloudflareAnalyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: SITE.cloudflareAnalyticsToken })}
        />
      )
    }
  </body>
</html>
