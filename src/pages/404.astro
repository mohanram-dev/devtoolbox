---
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import { SITE } from '../config';
import { TOOLS } from '../data/tools';
---

<Base title={`Page not found | ${SITE.name}`} description="That page does not exist." path="/404/" noindex>
  <div class="py-12 text-center">
    <p class="font-mono text-6xl font-bold text-brand-500">404</p>
    <h1 class="mt-4 text-2xl font-bold">Page not found</h1>
    <p class="mt-2 muted">The tool you are looking for may have moved. Try one of these instead:</p>
  </div>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {TOOLS.slice(0, 6).map((t) => <ToolCard tool={t} />)}
  </div>
</Base>
