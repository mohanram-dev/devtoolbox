---
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import ToolCard from '../../components/ToolCard.astro';
import ToolSearch from '../../components/ToolSearch';
import Icon from '../../components/Icon.astro';
import { SITE } from '../../config';
import { CATEGORIES, TOOLS, toolsInCategory, toolBySlug } from '../../data/tools';

const searchIndex = TOOLS.map(({ slug, name, tagline, category, keywords }) => ({ slug, name, tagline, category, keywords }));
const popular = ['json-formatter', 'jwt-decoder', 'base64-encode-decode', 'regex-tester', 'cron-parser'].map(toolBySlug).filter(Boolean);

const TINT: Record<string, string> = {
  Formatters: 'bg-sky-100 text-sky-600 dark:bg-sky-500/15 dark:text-sky-300',
  Encoders: 'bg-violet-100 text-violet-600 dark:bg-violet-500/15 dark:text-violet-300',
  Generators: 'bg-emerald-100 text-emerald-600 dark:bg-emerald-500/15 dark:text-emerald-300',
  Converters: 'bg-amber-100 text-amber-600 dark:bg-amber-500/15 dark:text-amber-300',
  Testing: 'bg-rose-100 text-rose-600 dark:bg-rose-500/15 dark:text-rose-300',
};

const jsonLd = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url + '/tools/', description: SITE.description }];
---

<Base title={`${SITE.name} – ${SITE.tagline}`} description={SITE.description} path="/tools/" jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="pb-10 pt-10 text-center sm:pt-12">
    <span class="badge">
      <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
      {TOOLS.length} tools · 100% client-side · no sign-up
    </span>
    <h1 class="mt-5 text-2xl font-bold tracking-tight sm:text-3xl">Free developer &amp; AI tools — <span class="text-gradient">no sign-up</span></h1>

    <div class="mt-9">
      <ToolSearch tools={searchIndex} client:idle />
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-center gap-2 text-sm">
      <span class="muted">Popular:</span>
      {popular.map((t) => (
        <a href={`/tools/${t!.slug}/`} class="badge transition hover:border-brand-400 hover:text-brand-500">
          {t!.name.replace(/\s*\(.*\)$/, '')}
        </a>
      ))}
    </div>
  </section>

  <AdSlot slot="headerBanner" format="horizontal" />

  <!-- Category sections -->
  {CATEGORIES.map((c) => {
    const items = toolsInCategory(c.name);
    if (!items.length) return null;
    return (
      <section id={c.name.toLowerCase()} class="mt-14 scroll-mt-24">
        <div class="flex items-center gap-3">
          <span class={`grid h-10 w-10 place-items-center rounded-xl ${TINT[c.name]}`}>
            <Icon name={c.name} class="h-5 w-5" />
          </span>
          <div>
            <h2 class="text-xl font-bold tracking-tight">{c.name}</h2>
            <p class="muted text-sm">{c.blurb}</p>
          </div>
        </div>
        <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {items.map((t) => <ToolCard tool={t} />)}
        </div>
      </section>
    );
  })}

  <!-- Value props -->
  <section class="card relative mt-20 overflow-hidden p-8 sm:p-10">
    <div class="pointer-events-none absolute -right-24 -top-24 h-64 w-64 rounded-full bg-brand-500/15 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-24 -left-24 h-64 w-64 rounded-full bg-accent-500/15 blur-3xl"></div>
    <div class="relative grid gap-8 sm:grid-cols-3">
      {[
        { icon: 'shield', title: 'Private by design', text: 'Every tool is pure client-side JavaScript. JSON, tokens and passwords never leave your machine.' },
        { icon: 'infinity', title: 'No accounts, no limits', text: 'Use any tool as often as you like. No sign-up walls, no rate limits, no premium tier.' },
        { icon: 'zap', title: 'Fast everywhere', text: 'Static pages with tiny scripts load instantly on desktop and mobile, even on slow connections.' },
      ].map((v) => (
        <div>
          <span class="bg-brand-gradient grid h-10 w-10 place-items-center rounded-xl text-white shadow-[0_6px_16px_-6px_rgb(99_102_241/.8)]">
            <Icon name={v.icon} class="h-5 w-5" />
          </span>
          <h3 class="mt-4 font-semibold">{v.title}</h3>
          <p class="muted mt-1.5 text-sm leading-6">{v.text}</p>
        </div>
      ))}
    </div>
  </section>
</Base>
